# Package built from the upstream prebuilt Linux tarball. makepkg uses a copy beside this
# file when present, and otherwise downloads it from the GitHub release.
# Upstream: https://github.com/storytold/craft-launcher

pkgname=artcraft-launcher-bin
_pkgname=artcraft-launcher
pkgver=0.5.1
pkgrel=2
pkgdesc="Install, update and launch the Craft App Suite (prebuilt binary)"
arch=('x86_64')
url="https://getartcraft.com/apps"
license=('MIT OR Apache-2.0' 'LicenseRef-ArtCraft-trademarks')
# The binary links only to glibc and libgcc; the windowing libraries below are loaded at runtime.
depends=(
  'dbus'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libglvnd'
  'libx11'
  'libxcursor'
  'libxi'
  'libxkbcommon'
  'libxkbcommon-x11'
  'wayland'
)
optdepends=(
  'flatpak: install Craft apps, which upstream ships as Flatpak bundles'
  'polkit: install Craft apps system-wide (pkexec)'
  'noto-fonts-cjk: Chinese, Japanese and Korean interface text'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}")
# Upstream ships the binary already stripped, so there is nothing for a debug package to hold.
options=('!strip' '!debug')
_tarball="${_pkgname}-${pkgver}-linux-x86_64.tar.gz"
source=("${_tarball}::https://github.com/storytold/craft-launcher/releases/download/v${pkgver}/${_tarball}")
# From upstream's SHA256SUMS.txt for the release.
sha256sums=('6cb893c5635e30f35629117c6992e1ea120e0bb6c17f0432e2c11387f3a7858a')

package() {
  cd "${_pkgname}-${pkgver}-linux-x86_64"

  install -Dm755 "bin/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

  install -Dm644 -t "${pkgdir}/usr/share/applications" share/applications/*.desktop
  install -Dm644 -t "${pkgdir}/usr/share/metainfo" share/metainfo/*.metainfo.xml

  local icon
  for icon in share/icons/hicolor/*/apps/*; do
    install -Dm644 "${icon}" "${pkgdir}/usr/${icon}"
  done

  local doc=share/doc/${_pkgname}
  install -Dm644 -t "${pkgdir}/usr/share/doc/${_pkgname}" "${doc}/README.md"
  # ATTRIBUTION.md holds the trademark notice that LicenseRef-ArtCraft-trademarks refers to.
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" \
    "${doc}/LICENSE-MIT" "${doc}/LICENSE-APACHE" "${doc}/NOTICE" "${doc}/ATTRIBUTION.md"
}
